<!-- Tier 2 probe: icons, tooltip, z-order, vertical text alignment, alpha, sequences, modal frame.
     python tools/annobridge/send.py --xml tools/annobridge/examples/tier2.dlg
     All ACCESSIDs are ANNORE_T2_*; the frame sits on the right half of a 1280x1024 screen. -->
<FRAME>
  <PATHID>ANNORE_T2</PATHID>
  <ACCESSID>ANNORE_T2</ACCESSID>
  <EXTENT><LEFT>780</LEFT><TOP>250</TOP><WIDTH>480</WIDTH><HEIGHT>640</HEIGHT></EXTENT>
  <TRANSPARENT>1</TRANSPARENT>

  <!-- 9: icons on labels -->
  <LABEL>
    <PATHID>ICON_COINS</PATHID><ACCESSID>ANNORE_T2_ICON_COINS</ACCESSID>
    <EXTENT><LEFT>10</LEFT><TOP>10</TOP><WIDTH>32</WIDTH><HEIGHT>32</HEIGHT></EXTENT>
    <ICONGUID>1160</ICONGUID><ICONSTRETCH>1</ICONSTRETCH>
    <TOOLTIP><TEXT>10140059</TEXT></TOOLTIP>
  </LABEL>
  <LABEL>
    <PATHID>ICON_BIG</PATHID><ACCESSID>ANNORE_T2_ICON_BIG</ACCESSID>
    <EXTENT><LEFT>60</LEFT><TOP>10</TOP><WIDTH>64</WIDTH><HEIGHT>64</HEIGHT></EXTENT>
    <ICONGUID>34020</ICONGUID><ICONSTRETCH>1</ICONSTRETCH>
    <TOOLTIP><TEXT>10142528</TEXT></TOOLTIP>
  </LABEL>
  <LABEL>
    <PATHID>ICON_TAG</PATHID><ACCESSID>ANNORE_T2_ICON_TAG</ACCESSID>
    <EXTENT><LEFT>140</LEFT><TOP>10</TOP><WIDTH>320</WIDTH><HEIGHT>40</HEIGHT></EXTENT>
    <TEXTSETTING><FONT>Tooltip</FONT></TEXTSETTING>
  </LABEL>

  <!-- 10: z-order: A is declared first with ZORDER 2, B second with ZORDER 1 -->
  <LABEL>
    <PATHID>Z_A</PATHID><ACCESSID>ANNORE_T2_Z_A</ACCESSID><ZORDER>2</ZORDER>
    <EXTENT><LEFT>10</LEFT><TOP>100</TOP><WIDTH>160</WIDTH><HEIGHT>60</HEIGHT></EXTENT>
    <BACKGROUND>addondata/config/gui/backgrounds/final/general_frames/bigmessagebackgroundgold.bkg</BACKGROUND>
    <TEXTSETTING><FONT>Tooltip</FONT></TEXTSETTING>
    <EVENTHANDLER><SETVISIBLE>ANNORE_T2_ICON_BIG; toggle</SETVISIBLE><EVENT>OnLeftClick</EVENT></EVENTHANDLER>
  </LABEL>
  <LABEL>
    <PATHID>Z_B</PATHID><ACCESSID>ANNORE_T2_Z_B</ACCESSID><ZORDER>1</ZORDER>
    <EXTENT><LEFT>90</LEFT><TOP>130</TOP><WIDTH>160</WIDTH><HEIGHT>60</HEIGHT></EXTENT>
    <BACKGROUND>addondata/config/gui/backgrounds/final/general_frames/tooltipbackgroundtiny.bkg</BACKGROUND>
    <TEXTSETTING><FONT>Tooltip</FONT></TEXTSETTING>
    <EVENTHANDLER><SETVISIBLE>ANNORE_T2_ICON_COINS; toggle</SETVISIBLE><EVENT>OnLeftClick</EVENT></EVENTHANDLER>
  </LABEL>

  <!-- 8: vertical text alignment on tall labels -->
  <LABEL>
    <PATHID>V0</PATHID><ACCESSID>ANNORE_T2_V0</ACCESSID>
    <EXTENT><LEFT>280</LEFT><TOP>100</TOP><WIDTH>60</WIDTH><HEIGHT>120</HEIGHT></EXTENT>
    <BACKGROUND>addondata/config/gui/backgrounds/final/general_frames/tooltipbackgroundtiny.bkg</BACKGROUND>
    <TEXTSETTING><FONT>Tooltip</FONT><ALIGNMENT_VERTICAL>0</ALIGNMENT_VERTICAL></TEXTSETTING>
  </LABEL>
  <LABEL>
    <PATHID>V1</PATHID><ACCESSID>ANNORE_T2_V1</ACCESSID>
    <EXTENT><LEFT>345</LEFT><TOP>100</TOP><WIDTH>60</WIDTH><HEIGHT>120</HEIGHT></EXTENT>
    <BACKGROUND>addondata/config/gui/backgrounds/final/general_frames/tooltipbackgroundtiny.bkg</BACKGROUND>
    <TEXTSETTING><FONT>Tooltip</FONT><ALIGNMENT_VERTICAL>1</ALIGNMENT_VERTICAL></TEXTSETTING>
  </LABEL>
  <LABEL>
    <PATHID>V2</PATHID><ACCESSID>ANNORE_T2_V2</ACCESSID>
    <EXTENT><LEFT>410</LEFT><TOP>100</TOP><WIDTH>60</WIDTH><HEIGHT>120</HEIGHT></EXTENT>
    <BACKGROUND>addondata/config/gui/backgrounds/final/general_frames/tooltipbackgroundtiny.bkg</BACKGROUND>
    <TEXTSETTING><FONT>Tooltip</FONT><ALIGNMENT_VERTICAL>2</ALIGNMENT_VERTICAL></TEXTSETTING>
  </LABEL>

  <!-- 11: alpha and sequences -->
  <LABEL>
    <PATHID>ALPHA</PATHID><ACCESSID>ANNORE_T2_ALPHA</ACCESSID>
    <EXTENT><LEFT>10</LEFT><TOP>240</TOP><WIDTH>200</WIDTH><HEIGHT>80</HEIGHT></EXTENT>
    <ALPHA>0.4</ALPHA>
    <BACKGROUND>addondata/config/gui/backgrounds/final/general_frames/bigmessagebackgroundgold.bkg</BACKGROUND>
    <TEXTSETTING><FONT>Tooltip</FONT></TEXTSETTING>
  </LABEL>
  <LABEL>
    <PATHID>FADER</PATHID><ACCESSID>ANNORE_T2_FADER</ACCESSID>
    <EXTENT><LEFT>230</LEFT><TOP>240</TOP><WIDTH>200</WIDTH><HEIGHT>80</HEIGHT></EXTENT>
    <BACKGROUND>addondata/config/gui/backgrounds/final/general_frames/bigmessagebackgroundgold.bkg</BACKGROUND>
    <TEXTSETTING><FONT>Tooltip</FONT></TEXTSETTING>
    <EVENT_REACTION_SEQUENCE>addondata/config/gui/sequences/onmouseenter_scalebig.xml</EVENT_REACTION_SEQUENCE>
  </LABEL>
  <BUTTON>
    <PATHID>FADE_OUT</PATHID><ACCESSID>ANNORE_T2_FADE_OUT</ACCESSID>
    <TEMPLATE_REF_ID>INGAME_MENUBUTTONS_TEMPLATE</TEMPLATE_REF_ID>
    <EXTENT><LEFT>10</LEFT><TOP>340</TOP><WIDTH>54</WIDTH><HEIGHT>54</HEIGHT></EXTENT>
    <EVENTHANDLER>
      <START_SEQUENCE>addondata/config/gui/sequences/buildmenufading.xml; FadeOut; ANNORE_T2_ICON_TAG, ANNORE_T2_FADER</START_SEQUENCE>
      <EVENT>OnLeftClick</EVENT>
    </EVENTHANDLER>
  </BUTTON>
  <BUTTON>
    <PATHID>FADE_IN</PATHID><ACCESSID>ANNORE_T2_FADE_IN</ACCESSID>
    <TEMPLATE_REF_ID>INGAME_MENUBUTTONS_TEMPLATE</TEMPLATE_REF_ID>
    <EXTENT><LEFT>80</LEFT><TOP>340</TOP><WIDTH>54</WIDTH><HEIGHT>54</HEIGHT></EXTENT>
    <EVENTHANDLER>
      <START_SEQUENCE>addondata/config/gui/sequences/buildmenufading.xml; FadeIn; ANNORE_T2_ICON_TAG, ANNORE_T2_FADER</START_SEQUENCE>
      <EVENT>OnLeftClick</EVENT>
    </EVENTHANDLER>
  </BUTTON>
  <BUTTON>
    <PATHID>SHOW_MODAL</PATHID><ACCESSID>ANNORE_T2_SHOW_MODAL</ACCESSID>
    <TEMPLATE_REF_ID>INGAME_MENUBUTTONS_TEMPLATE</TEMPLATE_REF_ID>
    <EXTENT><LEFT>150</LEFT><TOP>340</TOP><WIDTH>54</WIDTH><HEIGHT>54</HEIGHT></EXTENT>
    <EVENTHANDLER><SETVISIBLE>ANNORE_T2_MODAL; true</SETVISIBLE><EVENT>OnLeftClick</EVENT></EVENTHANDLER>
  </BUTTON>

  <!-- 7: a modal frame, hidden until SHOW_MODAL is clicked; its button hides it again -->
  <FRAME>
    <PATHID>MODAL</PATHID><ACCESSID>ANNORE_T2_MODAL</ACCESSID>
    <FRAME_MODAL>1</FRAME_MODAL><HIDDEN>1</HIDDEN><ZORDER>50</ZORDER>
    <EXTENT><LEFT>60</LEFT><TOP>420</TOP><WIDTH>360</WIDTH><HEIGHT>200</HEIGHT></EXTENT>
    <BACKGROUND>addondata/config/gui/backgrounds/final/general_frames/bigmessagebackgroundgold.bkg</BACKGROUND>
    <LABEL>
      <PATHID>MODAL_TEXT</PATHID><ACCESSID>ANNORE_T2_MODAL_TEXT</ACCESSID>
      <EXTENT><LEFT>20</LEFT><TOP>20</TOP><WIDTH>320</WIDTH><HEIGHT>60</HEIGHT></EXTENT>
      <TEXTSETTING><FONT>Tooltip</FONT></TEXTSETTING>
    </LABEL>
    <BUTTON>
      <PATHID>MODAL_CLOSE</PATHID><ACCESSID>ANNORE_T2_MODAL_CLOSE</ACCESSID>
      <TEMPLATE_REF_ID>INGAME_MENUBUTTONS_TEMPLATE</TEMPLATE_REF_ID>
      <EXTENT><LEFT>150</LEFT><TOP>110</TOP><WIDTH>54</WIDTH><HEIGHT>54</HEIGHT></EXTENT>
      <EVENTHANDLER><SETVISIBLE>ANNORE_T2_MODAL; false</SETVISIBLE><EVENT>OnLeftClick</EVENT></EVENTHANDLER>
    </BUTTON>
  </FRAME>
</FRAME>
