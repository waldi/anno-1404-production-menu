<!-- annobridge v8 example: a scroll box declared as XML, instantiated under SYSTEMMESSAGES.
     python tools/annobridge/send.py --xml tools/annobridge/examples/scrollbox.dlg
     Same grammar as the shipped .dlg files (tags and text, no attributes). Every tag the
     element types' ReadDefinitionNode understands works: EXTENT, BACKGROUND, TEXTSETTING,
     TEMPLATE_REF_ID, SCROLLBAR_*, EVENTHANDLER, HIDDEN... ACCESSIDs must be unique per game run. -->
<BOXLAYOUT>
  <PATHID>ANNORE_X_SCROLL</PATHID>
  <ACCESSID>ANNORE_X_SCROLL</ACCESSID>
  <EXTENT><LEFT>420</LEFT><TOP>560</TOP><WIDTH>300</WIDTH><HEIGHT>220</HEIGHT></EXTENT>
  <BACKGROUND>addondata/config/gui/backgrounds/final/general_frames/bigmessagebackgroundgold.bkg</BACKGROUND>
  <LINE_ORDER>0</LINE_ORDER>
  <SCROLLBAR_VERT>2</SCROLLBAR_VERT>
  <SCROLLBAR_VERT_TEMPLATE_REF_ID>SCROLLBAR_VERT_TEMPLATE</SCROLLBAR_VERT_TEMPLATE_REF_ID>
  <LABEL>
    <PATHID>ROW1</PATHID>
    <ACCESSID>ANNORE_X_ROW1</ACCESSID>
    <EXTENT><LEFT>0</LEFT><TOP>0</TOP><WIDTH>240</WIDTH><HEIGHT>26</HEIGHT></EXTENT>
    <TEXTSETTING><TEXTGUID>140040</TEXTGUID><FONT>Tooltip</FONT></TEXTSETTING>
  </LABEL>
  <LABEL>
    <PATHID>ROW2</PATHID>
    <ACCESSID>ANNORE_X_ROW2</ACCESSID>
    <EXTENT><LEFT>0</LEFT><TOP>0</TOP><WIDTH>240</WIDTH><HEIGHT>26</HEIGHT></EXTENT>
    <TEXTSETTING><TEXTGUID>140040</TEXTGUID><FONT>Tooltip</FONT></TEXTSETTING>
  </LABEL>
  <LABEL>
    <PATHID>ROW3</PATHID>
    <ACCESSID>ANNORE_X_ROW3</ACCESSID>
    <EXTENT><LEFT>0</LEFT><TOP>0</TOP><WIDTH>240</WIDTH><HEIGHT>26</HEIGHT></EXTENT>
    <TEXTSETTING><TEXTGUID>140040</TEXTGUID><FONT>Tooltip</FONT></TEXTSETTING>
  </LABEL>
  <LABEL>
    <PATHID>ROW4</PATHID>
    <ACCESSID>ANNORE_X_ROW4</ACCESSID>
    <EXTENT><LEFT>0</LEFT><TOP>0</TOP><WIDTH>240</WIDTH><HEIGHT>26</HEIGHT></EXTENT>
    <TEXTSETTING><TEXTGUID>140040</TEXTGUID><FONT>Tooltip</FONT></TEXTSETTING>
  </LABEL>
  <LABEL>
    <PATHID>ROW5</PATHID>
    <ACCESSID>ANNORE_X_ROW5</ACCESSID>
    <EXTENT><LEFT>0</LEFT><TOP>0</TOP><WIDTH>240</WIDTH><HEIGHT>26</HEIGHT></EXTENT>
    <TEXTSETTING><TEXTGUID>140040</TEXTGUID><FONT>Tooltip</FONT></TEXTSETTING>
  </LABEL>
  <LABEL>
    <PATHID>ROW6</PATHID>
    <ACCESSID>ANNORE_X_ROW6</ACCESSID>
    <EXTENT><LEFT>0</LEFT><TOP>0</TOP><WIDTH>240</WIDTH><HEIGHT>26</HEIGHT></EXTENT>
    <TEXTSETTING><TEXTGUID>140040</TEXTGUID><FONT>Tooltip</FONT></TEXTSETTING>
  </LABEL>
  <LABEL>
    <PATHID>ROW7</PATHID>
    <ACCESSID>ANNORE_X_ROW7</ACCESSID>
    <EXTENT><LEFT>0</LEFT><TOP>0</TOP><WIDTH>240</WIDTH><HEIGHT>26</HEIGHT></EXTENT>
    <TEXTSETTING><TEXTGUID>140040</TEXTGUID><FONT>Tooltip</FONT></TEXTSETTING>
  </LABEL>
  <LABEL>
