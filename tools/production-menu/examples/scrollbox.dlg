    <EXTENT><LEFT>0</LEFT><TOP>0</TOP><WIDTH>240</WIDTH><HEIGHT>26</HEIGHT></EXTENT>
    <TEXTSETTING><TEXTGUID>140040</TEXTGUID><FONT>Tooltip</FONT></TEXTSETTING>
  </LABEL>
  <BUTTON>
    <PATHID>HIDE_ROW1</PATHID>
    <ACCESSID>ANNORE_X_HIDE_ROW1</ACCESSID>
    <TEMPLATE_REF_ID>INGAME_MENUBUTTONS_TEMPLATE</TEMPLATE_REF_ID>
    <EXTENT><LEFT>0</LEFT><TOP>0</TOP><WIDTH>54</WIDTH><HEIGHT>54</HEIGHT></EXTENT>
    <EVENTHANDLER>
      <SETVISIBLE>ANNORE_X_ROW1; toggle</SETVISIBLE>
      <EVENT>OnLeftClick</EVENT>
    </EVENTHANDLER>
  </BUTTON>
</BOXLAYOUT>
