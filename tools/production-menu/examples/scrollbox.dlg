    <ACCESSID>ANNORE_X_ROW8</ACCESSID>
    <EXTENT><LEFT>0</LEFT><TOP>0</TOP><WIDTH>240</WIDTH><HEIGHT>26</HEIGHT></EXTENT>
    <TEXTSETTING><TEXTGUID>140040</TEXTGUID><FONT>Tooltip</FONT></TEXTSETTING>
  </LABEL>
