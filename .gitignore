tools/production-menu/AnnoRECompanion.exe
tools/production-menu/*.obj
tools/production-menu/*.exp
tools/production-menu/*.lib

.npm-cache
.tmp

# Standalone Tauri GUI editor: dependencies, build outputs and working copies
tools/gui_editor/node_modules/
tools/gui_editor/dist/
tools/gui_editor/src-tauri/target/
tools/gui_editor/.cargo-cache/
tools/gui_editor/.npm-cache/
tools/gui_editor/.tmp/
